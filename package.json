{
  "name": "apex-home-fitness",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "audit:assets": "node scripts/audit-assets.mjs",
    "audit:design": "node scripts/audit-design-system.mjs",
    "audit:lottie": "node scripts/audit-lottie-fps.mjs",
    "guardrail:check": "node scripts/guardrail-check.mjs scripts/release-manifest.example.json",
    "guardrail:test": "node --test tests/guardrail-check.test.mjs",
    "governance:check": "node scripts/governance-runtime.mjs docs && node scripts/governance-runtime.mjs ui",
    "governance:test": "node --test tests/governance-runtime.test.mjs",
    "admin:provision": "node --import tsx scripts/provision-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx",
    "test:e2e": "playwright test --config=infra/config/playwright.config.ts",
    "test:e2e:smoke": "playwright test --config=infra/config/playwright.config.ts tests/main-flows.spec.ts",
    "test:e2e:auth": "playwright test --config=infra/config/playwright.config.ts tests/auth-flow.spec.ts",
    "test:e2e:quiz": "playwright test --config=infra/config/playwright.config.ts tests/main-flows.spec.ts tests/rest-days.spec.ts tests/quiz-contrast.spec.ts",
    "test:e2e:full": "playwright test --config=infra/config/playwright.config.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^1.2.9",
    "@ai-sdk/openai": "^1.3.24",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.3.1",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "ai": "^4.3.19",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "hls.js": "^1.7.0",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.427.0",
    "next": "15.5.23",
    "next-intl": "4.13.7",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@swc/helpers": "^0.5.23",
    "@types/node": "^22.20.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^8",
    "eslint-config-next": "15.5.23",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
