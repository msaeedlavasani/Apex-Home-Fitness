// Prisma schema for Apex Home Fitness
// ---------------------------------------------------------------
// Models: User, Exercise, Program, WorkoutSession, QuizResponse
//
// NOTE: uses SQLite + Json/array fields — requires Prisma >= 6.2.0
// (earlier Prisma versions support Json only on PostgreSQL/MongoDB).
//
// Environment:
//   DATABASE_URL="file:./dev.db"
//   npx prisma migrate dev --name init
//   npx prisma db seed   (runs prisma/seed.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

// The 8 exercise categories supported by Apex Home Fitness.
enum ExerciseCategory {
  YOGA
  HIIT
  CALISTHENICS
  PILATES
  MOBILITY
  ISOMETRIC
  RESISTANCE_BAND
  ANIMAL_FLOW
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// What a phone OTP challenge was issued for. Only SIGNIN exists today; the
// enum leaves room for future purposes (e.g. ACCOUNT_RECOVERY) without
// widening the model later. SQLite stores enums as TEXT.
enum OtpPurpose {
  SIGNIN
}

// Lifecycle of an idempotent program-generation request (see
// `ProgramGenerationRequest`). SQLite stores enums as TEXT.
enum GenerationRequestStatus {
  // A generation is running (or a crashed request is stale and reclaimable).
  IN_PROGRESS
  // The program was persisted; retries replay the cached response.
  SUCCEEDED
  // The attempt errored; a retry with the same key starts a fresh attempt.
  FAILED
}

// ---------------------------------------------------------------
// Models
// ---------------------------------------------------------------

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String
  passwordHash  String
  heightCm      Int?
  weightKg      Float?
  fitnessGoal   String?
  fitnessLevel  DifficultyLevel?
  // Gamification (see src/services/gamificationService.ts): lifetime XP, the
  // derived player level (level = floor(xp / 100) + 1) and the badges earned
  // so far. `badges` is a Json array of { id, awardedAt } objects, e.g.
  //   [ { "id": "first_workout", "awardedAt": "2026-08-15T10:00:00.000Z" } ]
  // It is nullable because SQLite (this repo's datasource) does not support
  // @default() on Json fields — the service normalizes null to [].
  xp            Int              @default(0)
  level         Int              @default(1)
  badges        Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  programs        Program[]        @relation("UserPrograms")
  workoutSessions WorkoutSession[]
  quizResponses   QuizResponse[]
  generationRequests ProgramGenerationRequest[]
}

// A single exercise. Category drives the program builder; the
// equipment list is flexible (any number of optional gear items),
// e.g. ["yoga mat"], ["resistance band", "pull-up bar"], [].
model Exercise {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String
  category        ExerciseCategory
  equipment       Json             // flexible, possibly empty list of required/optional gear
  difficulty      DifficultyLevel
  durationSeconds Int?             // approx. time for one working set
  reps            Int?
  sets            Int?
  restSeconds     Int?
  instructions    Json             // ordered step-by-step cues
  imageUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  programExercises ProgramExercise[]
  sessionExercises WorkoutSessionExercise[]

  @@index([category])
  @@index([difficulty])
  // Program builder / AI generator lookups filter by category AND difficulty
  // together (e.g. "HIIT exercises for intermediates") — one composite index
  // serves both combined and single-column (leftmost prefix) lookups.
  @@index([category, difficulty])
}

// A structured training plan. Exercises are linked through the
// ProgramExercise join model (order, sets, reps, rest per entry).
//
// Persistence timeouts: writes to this model (and its joins) are bounded
// client-side — see `src/lib/timeout.ts` (PERSIST_TIMEOUT_MS /
// PERSIST_TRANSACTION_TIMEOUT_MS) and `persistProgramForUser` in
// `src/services/programService.ts`. SQLite exposes no statement-level timeout,
// so the deadline is enforced by the Prisma client.
model Program {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String
  level           DifficultyLevel
  durationWeeks   Int
  sessionsPerWeek Int?
  // Weekday ids the user selected as rest days (1–3), e.g.
  //   [ "wednesday", "sunday" ]
  // Set by `persistProgramForUser` from the generation input; null for
  // programs created before this feature. It is nullable because SQLite
  // (this repo's datasource) does not support @default() on Json fields.
  restDays        Json?
  weeklySchedule  Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  owner            User?            @relation("UserPrograms", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId          String?
  exercises        ProgramExercise[]
  workoutSessions  WorkoutSession[]
  quizRecommendations QuizResponse[]
  generationRequests ProgramGenerationRequest[]

  // FK lookup path: list programs owned by a user. SQLite does not
  // auto-index foreign keys, so this makes owner-scoped queries index-backed.
  @@index([ownerId])
}

// Join table: which exercises a program contains, in what order,
// and with which prescription (sets / reps / rest).
model ProgramExercise {
  programId   String
  exerciseId  String
  order       Int
  sets        Int?
  reps        Int?
  restSeconds Int?

  program  Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([programId, exerciseId])
  @@index([exerciseId])
  // `programWithDetails` (programService) loads a program's exercises ordered
  // by `order` — (programId, order) turns that into an ordered index scan and
  // removes the sort step (the @@id leftmost prefix only covers programId).
  @@index([programId, order])
}

// A completed or in-progress workout performed by a user,
// optionally linked to a program.
model WorkoutSession {
  id              String     @id @default(cuid())
  userId          String
  programId       String?
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  caloriesBurned  Int?
  notes           String?
  // Gamification idempotency guard: set to true by
  // `gamificationService.awardXpForWorkout` so a session's XP / badge rewards
  // are never double-awarded (e.g. on a retried completion event).
  xpAwarded       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program?                @relation(fields: [programId], references: [id], onDelete: SetNull)
  exercises WorkoutSessionExercise[]

  // Composite (userId, date) indexes — the analytics hot path:
  //   - getWorkoutAnalytics filters by userId AND completedAt (totals, streaks)
  //     and orders by startedAt (first/last workout, weekly bucketing).
  //   - The userId leftmost prefix also serves every `where: { userId }` query
  //     the old single-column @@index([userId]) covered, so it is replaced.
  @@index([userId, startedAt])
  @@index([userId, completedAt])
  @@index([programId])
}

// Join table: exercises actually performed inside a session,
// with completion status and actual volume.
model WorkoutSessionExercise {
  sessionId       String
  exerciseId      String
  order           Int
  completed       Boolean    @default(false)
  actualSets      Int?
  actualReps      Int?
  durationSeconds Int?

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@id([sessionId, exerciseId])
  @@index([exerciseId])
  // Analytics reads volume/calorie inputs for a user's completed sessions via
  // `where: { completed: true, session: { userId, completedAt: { not: null } } }`
  // — (sessionId, completed) serves the session-scoped scan + completion filter.
  @@index([sessionId, completed])
}

// Answers to the onboarding quiz used to recommend programs.
// `answers` is a flexible JSON payload, e.g.:
//   { "goal": ["fatLoss", "strength"], "experience": "beginner",
//     "timePerSessionMin": 30, "equipment": ["yoga mat", "resistance band"] }
// Note: `goal` is a multi-select array; legacy single-string values
// (`"goal": "fatLoss"`) are normalized to arrays by the API schema.
model QuizResponse {
  id                    String   @id @default(cuid())
  userId                String
  answers               Json // flexible answer payload
  recommendedProgramId  String?
  score                 Float?
  // Client-supplied idempotency key (8–64 URL-safe chars, e.g. the quiz
  // draft's completionId). UNIQUE + set by `saveQuizResponse` — a replayed
  // save (retry after a lost response, refresh mid-flow) returns the SAME
  // QuizResponse instead of persisting a duplicate. Scoped to the owner at
  // read time, so one user can never replay another user's key.
  clientRequestId       String?  @unique
  createdAt             DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendedProgram Program? @relation(fields: [recommendedProgramId], references: [id], onDelete: SetNull)

  // getQuizResponses filters by userId and orders by createdAt DESC — the
  // composite index serves the filter (leftmost prefix) AND the sort, so the
  // database never materializes + sorts the user's full response history.
  @@index([userId, createdAt])
  @@index([recommendedProgramId])
}

// Idempotency ledger for `POST /api/generate-program`. One row per
// (userId, Idempotency-Key). Guards against duplicate program persistence on
// client retries and concurrent duplicate requests:
//   - IN_PROGRESS: a generation is running (or a crashed one is stale).
//   - SUCCEEDED:   the program was persisted; retries replay `responsePayload`.
//   - FAILED:      the attempt errored; a retry with the same key re-executes.
// `requestHash` is a SHA-256 of the normalized request body — replaying a key
// with a different body is rejected as a conflict. No secrets are stored.
model ProgramGenerationRequest {
  id             String                   @id @default(cuid())
  userId         String
  idempotencyKey String
  requestHash    String
  status         GenerationRequestStatus  @default(IN_PROGRESS)
  // The persisted Program for a SUCCEEDED request (replay path reads it).
  programId      String?
  // Cached 200 response body { program, generated } for exact retry replays.
  responsePayload Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  // One record per (user, key) — the uniqueness guarantee that makes
  // concurrent duplicate creation impossible.
  @@unique([userId, idempotencyKey])
  @@index([programId])
  // Lazy retention cleanup drops rows older than 30 days by `updatedAt`.
  @@index([updatedAt])
}

// Phone OTP challenge ledger (see `src/services/otpService.ts` and
// `docs/OTP_LAUNCH_READINESS.md`). One row per SMS OTP challenge issued for a phone.
//
// Security properties enforced here (each backed by a unit test):
//   - `codeHash` stores ONLY a scrypt digest of the 6-digit code (random
//     per-record salt) — the plaintext code never touches the database, so a
//     leaked DB dump cannot be brute-forced offline (scrypt cost) and support
//     staff can never read a code.
//   - `expiresAt` + `maxAttempts` bound the lifetime of a challenge; every
//     verify attempt increments `attempts` atomically.
//   - `consumedAt` makes a challenge single-use: verification consumes the
//     row atomically (`updateMany ... where consumedAt: null`), so a replayed
//     verify request can never succeed twice.
//   - `requestId` (client-supplied idempotency key or server-generated UUID)
//     is UNIQUE — the same key replaying `/request` returns the original
//     challenge without re-sending SMS, and a key reused for a different phone
//     is rejected.
//
// `phone` is stored as the normalized E.164-ish identifier (e.g.
// `+989121234567`) — it is the account identifier, not a secret. The CODE is
// the secret, and it is never stored in plaintext.
model PhoneOtp {
  id          String      @id @default(cuid())
  phone       String
  purpose     OtpPurpose  @default(SIGNIN)
  requestId   String      @unique
  codeHash    String
  attempts    Int         @default(0)
  maxAttempts Int         @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime    @default(now())

  // Verify looks up by (requestId, phone); the phone leftmost prefix also
  // serves the cooldown query (active challenge for a phone) and cleanup.
  @@index([phone, purpose])
  // Lazy retention cleanup drops consumed/expired rows by `consumedAt`.
  @@index([consumedAt])
  // Expiry scans (markExpired / cleanup) filter by `expiresAt`.
  @@index([expiresAt])
}
