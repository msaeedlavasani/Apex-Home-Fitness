// Prisma schema for Apex Home Fitness
// ---------------------------------------------------------------
// Models: User, Exercise, Program, WorkoutSession, QuizResponse
//
// NOTE: uses SQLite + Json/array fields — requires Prisma >= 6.2.0
// (earlier Prisma versions support Json only on PostgreSQL/MongoDB).
//
// Environment:
//   DATABASE_URL="file:./dev.db"
//   npx prisma migrate dev --name init
//   npx prisma db seed   (runs prisma/seed.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

// The 8 exercise categories supported by Apex Home Fitness.
enum ExerciseCategory {
  YOGA
  HIIT
  CALISTHENICS
  PILATES
  MOBILITY
  ISOMETRIC
  RESISTANCE_BAND
  ANIMAL_FLOW
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ---------------------------------------------------------------
// Models
// ---------------------------------------------------------------

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String
  passwordHash  String
  heightCm      Int?
  weightKg      Float?
  fitnessGoal   String?
  fitnessLevel  DifficultyLevel?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  programs        Program[]        @relation("UserPrograms")
  workoutSessions WorkoutSession[]
  quizResponses   QuizResponse[]
}

// A single exercise. Category drives the program builder; the
// equipment list is flexible (any number of optional gear items),
// e.g. ["yoga mat"], ["resistance band", "pull-up bar"], [].
model Exercise {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String
  category        ExerciseCategory
  equipment       Json             // flexible, possibly empty list of required/optional gear
  difficulty      DifficultyLevel
  durationSeconds Int?             // approx. time for one working set
  reps            Int?
  sets            Int?
  restSeconds     Int?
  instructions    Json             // ordered step-by-step cues
  imageUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  programExercises ProgramExercise[]
  sessionExercises WorkoutSessionExercise[]

  @@index([category])
  @@index([difficulty])
}

// A structured training plan. Exercises are linked through the
// ProgramExercise join model (order, sets, reps, rest per entry).
model Program {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String
  level           DifficultyLevel
  durationWeeks   Int
  sessionsPerWeek Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  owner            User?            @relation("UserPrograms", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId          String?
  exercises        ProgramExercise[]
  workoutSessions  WorkoutSession[]
  quizRecommendations QuizResponse[]
}

// Join table: which exercises a program contains, in what order,
// and with which prescription (sets / reps / rest).
model ProgramExercise {
  programId   String
  exerciseId  String
  order       Int
  sets        Int?
  reps        Int?
  restSeconds Int?

  program  Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([programId, exerciseId])
  @@index([exerciseId])
}

// A completed or in-progress workout performed by a user,
// optionally linked to a program.
model WorkoutSession {
  id              String     @id @default(cuid())
  userId          String
  programId       String?
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  caloriesBurned  Int?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program?                @relation(fields: [programId], references: [id], onDelete: SetNull)
  exercises WorkoutSessionExercise[]

  @@index([userId])
  @@index([programId])
}

// Join table: exercises actually performed inside a session,
// with completion status and actual volume.
model WorkoutSessionExercise {
  sessionId       String
  exerciseId      String
  order           Int
  completed       Boolean    @default(false)
  actualSets      Int?
  actualReps      Int?
  durationSeconds Int?

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@id([sessionId, exerciseId])
  @@index([exerciseId])
}

// Answers to the onboarding quiz used to recommend programs.
// `answers` is a flexible JSON payload, e.g.:
//   { "goal": "fatLoss", "experience": "beginner",
//     "timePerSessionMin": 30, "equipment": ["yoga mat", "resistance band"] }
model QuizResponse {
  id                    String   @id @default(cuid())
  userId                String
  answers               Json // flexible answer payload
  recommendedProgramId  String?
  score                 Float?
  createdAt             DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendedProgram Program? @relation(fields: [recommendedProgramId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([recommendedProgramId])
}
