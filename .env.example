# Copy to .env and fill in real values (never commit real secrets).
DATABASE_URL="file:./dev.db"

# --- CI / E2E (no real secrets) -------------------------------------------
# GitHub Actions CI (see .github/workflows/ci.yml) sets ONLY a placeholder
# `DATABASE_URL="file:./ci.db"` — never real secrets. This is sufficient
# because:
#   - `prisma generate`, `next build` and `npm run dev` all work without
#     Supabase/Sentry/OpenAI envs (the app degrades gracefully: console error
#     reporter, signed-out profile fallback).
#   - The Playwright E2E suite (tests/*.spec.ts, run via `npm run test:e2e`)
#     covers UI flows only — localization, onboarding quiz, theme, keyboard,
#     ARIA, offline shell. None of them require auth or a real database.
#
# Flows that DO need real credentials are intentionally NOT part of CI E2E:
#   - POST /api/generate-program (AI program generation) requires a real
#     Supabase project (NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY)
#     for auth and an OpenAI API key (OPENAI_API_KEY, consumed by
#     @ai-sdk/openai). The GitHub Actions repository secret with this exact
#     name is injected into build/E2E jobs, but AI calls remain outside the
#     current UI-only E2E suite. Exercise AI generation locally / in staging.
#   - Sentry DSNs enable real error reporting; without them a console
#     reporter is used (src/lib/errorTracking.ts).
#
# If a future E2E test starts exercising auth or the DB, it must be gated on
# explicit env flags (e.g. `E2E_REQUIRES_AUTH=1`) and skipped transparently
# when unset — never silently hidden behind a mocked failure.

# --- PWA / TWA (required for Android release) ------------------------------
# Canonical production origin (HTTPS). Used for OG/social absolute URLs
# (generateMetadata metadataBase) and as the `host` origin of the Android
# Trusted Web Activity. Must match the deployed domain that serves
# /.well-known/assetlinks.json. See RELEASING.md.
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# --- Monitoring (optional) -------------------------------------------------
# Error tracking: set a Sentry DSN to enable real error reporting. Requires
# the Sentry SDK to be installed (`npm i @sentry/nextjs`) — see
# src/lib/errorTracking.ts. Without a DSN the app uses a console reporter.
#
# Client-side (browser) errors:
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Server-side (Node) errors:
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# --- AI rate limiting (shared storage) ------------------------------------
# Rate limiting for POST /api/generate-program (IP / user / daily windows +
# per-user concurrency) goes through a swappable store
# (src/lib/ai/rateLimitStore.ts). Choose the backend explicitly:
#
#   RATE_LIMIT_STORE=memory  (DEFAULT) — process-local fallback. Zero config,
#     no secrets, but NOT shared across instances and reset on restart. Fine
#     for local development.
#
#   RATE_LIMIT_STORE=redis  — shared, multi-instance-safe backend backed by an
#     Upstash REST-compatible Redis API (atomic INCR+EXPIRE windows and
#     SET NX PX concurrency locks). Requires BOTH REDIS_REST_URL and
#     REDIS_REST_TOKEN below. Never commit a real token — keep placeholders in
#     this file and inject the real values via the deployment environment.
#
# RATE_LIMIT_STORE=memory
# REDIS_REST_URL=https://your-project.upstash.io
# REDIS_REST_TOKEN=placeholder-token-do-not-commit

# --- OTP / SMS.ir auth (required for production login — Batch 14) -----------
# Placeholders only — real values are injected via the deployment environment
# / secret manager, never committed. See docs/OTP_LAUNCH_READINESS.md.
#
# SMS.ir REST API key (sent as the `X-API-KEY` header to
# `POST https://api.sms.ir/v1/send/verify`). Server-only — never referenced
# from client code. Env names match `src/lib/auth/smsIrProvider.ts`.
# SMS_IR_API_KEY=placeholder-api-key-do-not-commit
# SMS.ir verification template id (created in the SMS.ir panel; must be
# enabled and contain the code parameter). Use the *real* id in production.
# SMS_IR_TEMPLATE_ID=100000
# Optional SMS.ir transport settings (defaults shown):
# SMS_IR_API_BASE_URL=https://api.sms.ir   # override base URL (tests/mocks)
# SMS_IR_CODE_PARAMETER=CODE               # template parameter receiving the code
# SMS_IR_TIMEOUT_MS=5000                   # outbound request timeout
#
# OTP code policy — server-side only; env names match `src/lib/auth/otp.ts`
# (`getOtpPolicy`). Sane production defaults shown; leave unset to use them.
# OTP_CODE_LENGTH=6                 # digits in the generated code
# OTP_CODE_TTL_MS=600000            # code expiry (10 min)
# OTP_RESEND_COOLDOWN_MS=60000      # min gap before a new code for the same phone
# OTP_MAX_ATTEMPTS=5                # failed verify attempts per code
# OTP_REQUEST_PHONE_WINDOW_MS=900000   # fixed window: /request per phone (15 min)
# OTP_REQUEST_PHONE_LIMIT=5
# OTP_REQUEST_IP_WINDOW_MS=900000      # fixed window: /request per IP (15 min)
# OTP_REQUEST_IP_LIMIT=10
# OTP_VERIFY_PHONE_WINDOW_MS=900000    # fixed window: /verify per phone (15 min)
# OTP_VERIFY_PHONE_LIMIT=5
# OTP_VERIFY_IP_WINDOW_MS=900000       # fixed window: /verify per IP (15 min)
# OTP_VERIFY_IP_LIMIT=10
#
# OTP rate limiting reuses the shared AI rate-limit store
# (src/lib/ai/rateLimitStore.ts): use `redis` in production (multi-instance).
# RATE_LIMIT_STORE=redis        # see the "AI rate limiting" section above
#
# Supabase auth (needed once OTP login is live; the app degrades gracefully
# without it). Set the same project's URL + anon key in production and add the
# production origin to Authentication → URL Configuration (Site URL + Redirect
# URLs — see docs/OTP_LAUNCH_READINESS.md §4).
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-do-not-commit
#
# Smoke-test gate — never enables real SMS accidentally.
#   unset / 'mock' → SMS.ir provider is replaced by the mock harness
#                    (no real SMS; non-production only)
#   'real'        → sends real SMS to SMOKE_TEST_PHONE (STAGING ONLY, with
#                    explicit owner consent; never in production)
# SMOKE_TEST_MODE=mock
# SMOKE_TEST_PHONE=            # consenting test number (staging only)
#
# Route protection dev switch (Batch 14 task 4) — DEV/CI ONLY, never in
# production. When no Supabase env is present, setting
#   AUTH_OTP_MODE=mock
# arms the middleware protection (dashboard/workout/history/analytics/
# challenges/profile → /{locale}/auth/login) so tests/auth-flow.spec.ts can
# exercise the redirect behaviour and the bilingual OTP UI without a real
# Supabase project. It NEVER mints sessions: sessions are always the real
# Supabase Auth/SSR ones, and without Supabase env the login API fails
# honestly (503) instead of faking success. See src/lib/auth/mode.ts.
# AUTH_OTP_MODE=mock
