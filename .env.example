[TEMPLATE]
[TEMPLATE]
# Copy to .env and fill in real values (never commit real secrets).
DATABASE_URL="file:./dev.db"

# --- CI / E2E (no real secrets) -------------------------------------------
# GitHub Actions CI (see .github/workflows/ci.yml) sets ONLY a placeholder
# `DATABASE_URL="file:./ci.db"` — never real secrets. This is sufficient
# because `prisma generate`, `next build` and `npm run dev` all work without
# Supabase/Sentry/AI envs (the app degrades gracefully).
#
# Flows that need real credentials are intentionally outside the ordinary UI
# E2E suite: auth-backed API calls, program generation, and real SMS delivery.
# Gate any future provider E2E on an explicit env flag; never hide failures
# behind a mocked success.

# --- PWA / TWA (required for Android release) ------------------------------
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
# NEXT_PUBLIC_RELEASE=$(git rev-parse --short HEAD)

# --- Monitoring (optional) -------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# --- AI rate limiting (shared storage) ------------------------------------
# RATE_LIMIT_STORE=memory
# REDIS_REST_URL=https://your-project.upstash.io
# REDIS_REST_TOKEN=placeholder-token-do-not-commit

# --- Program generation providers (server-only) ----------------------------
# Explicit architecture: configured AI provider first, deterministic rules fallback.
# PROGRAM_GENERATOR=rules skips all external AI calls (useful for local/CI).
# PROGRAM_GENERATOR=ai
# AI_PROVIDER=groq
# AI_GENERATION_FALLBACK=rules
# AI_MODEL=
# GROQ_API_KEY=placeholder-groq-key-do-not-commit
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY=placeholder-openai-key-do-not-commit
# OPENAI_MODEL=gpt-4o-mini
# Optional opt-in provider smoke test; never enabled by ordinary CI.
# RUN_AI_PROVIDER_SMOKE=1

# --- OTP / SMS.ir auth (required for production login — Batch 14) -----------
# SMS_IR_API_KEY=placeholder-api-key-do-not-commit
# SMS_IR_TEMPLATE_ID=100000
# SMS_IR_API_BASE_URL=https://api.sms.ir
# SMS_IR_CODE_PARAMETER=otp
# SMS_IR_TIMEOUT_MS=5000
# OTP_CODE_LENGTH=6
# OTP_CODE_TTL_MS=900000
# OTP_RESEND_COOLDOWN_MS=60000
# OTP_MAX_ATTEMPTS=5
# OTP_REQUEST_PHONE_WINDOW_MS=900000
# OTP_REQUEST_PHONE_LIMIT=5
# OTP_REQUEST_IP_WINDOW_MS=900000
# OTP_REQUEST_IP_LIMIT=10
# OTP_VERIFY_PHONE_WINDOW_MS=900000
# OTP_VERIFY_PHONE_LIMIT=5
# OTP_VERIFY_IP_WINDOW_MS=900000
# OTP_VERIFY_IP_LIMIT=10
#
# SMS/OTP and Supabase values are server-side deployment configuration.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-do-not-commit
# SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-do-not-commit
# Profile avatars use Supabase Storage: create a PRIVATE bucket named `avatars`
# (objects `<userId>.<ext>`, served via short-lived signed URLs). Without the
# URL + service-role key the app falls back to storing the avatar data URL in
# the DB (dev/mock only).
# AUTH_OTP_MODE=mock
# OTP_AUTH_ENABLED=true
# AUTH_OTP_MOCK_IN_PRODUCTION=true
# AUTH_OTP_MOCK_PHONES=
# SMOKE_TEST_MODE=mock
# SMOKE_TEST_PHONE=
