#!/usr/bin/env python3
import json, socket, sys
SOCKET="/run/apex-deploy-gateway/gateway.sock"
if len(sys.argv)==2 and sys.argv[1]=="status": request={"action":"status","schema_version":1}
elif len(sys.argv)==2:
    with open(sys.argv[1],encoding="utf-8") as handle: request=json.load(handle)
else: raise SystemExit("usage: apex-deploy status | apex-deploy <request.json>")
payload=json.dumps(request,separators=(",",":")).encode()
if len(payload)>16384: raise SystemExit("request too large")
client=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); client.connect(SOCKET); client.sendall(payload); client.shutdown(socket.SHUT_WR)
response=b""
while chunk:=client.recv(4096): response+=chunk
print(response.decode().strip())
data=json.loads(response)
raise SystemExit(0 if data.get("ok") else 1)
